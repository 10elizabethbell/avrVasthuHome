    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The main action on blueprint and the form send button.",
      "html": "<a class=\"ds-btn ds-btn-primary\" href=\"#\">Start my plan</a>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;min-height:56px;padding:0 18px;border-radius:12px;font:750 17px/1.1 var(--font);text-decoration:none;border:2px solid #f2a516;cursor:pointer;transition:background-color .2s,color .2s,transform .15s}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:3px solid #2f78d0;outline-offset:3px}.ds-btn-primary{background:#f2a516;color:#11304f}.ds-btn-primary:hover{background:#ffb72e}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Secondary action, on blueprint only.",
      "html": "<div style=\"background:#11304f;padding:20px\"><a class=\"ds-btn-ghost\" href=\"#\">See prices</a></div>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;justify-content:center;min-height:56px;padding:0 18px;border-radius:12px;font:750 17px/1.1 var(--font);text-decoration:none;border:2px solid #f2a516;background:transparent;color:#fff;transition:background-color .2s}.ds-btn-ghost:hover{background:rgba(242,165,22,.12)}.ds-btn-ghost:focus-visible{outline:3px solid #f2a516;outline-offset:3px}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input-text",
      "description": "Form fields on paper; Form Blue on hover and focus.",
      "html": "<input class=\"ds-input\" type=\"text\" placeholder=\"Tirunelveli\">",
      "css": ".ds-input{width:100%;min-height:52px;border:1.5px solid #8f846e;border-radius:10px;background:#fffdf8;padding:0 14px;font:400 17px var(--font);color:#1a2a3b;transition:border-color .15s,box-shadow .15s}.ds-input::placeholder{color:#756e60}.ds-input:hover{border-color:#2f78d0}.ds-input:focus{outline:none;border-color:#2f78d0;box-shadow:0 0 0 3px rgba(47,120,208,.25)}"
    },
    {
      "name": "Choice Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Radio/checkbox choice; selected fills with blueprint ink.",
      "html": "<span class=\"ds-chips\"><label class=\"ds-chip\"><input type=\"radio\" name=\"f\" checked><span>G+1</span></label><label class=\"ds-chip\"><input type=\"radio\" name=\"f\"><span>G+2</span></label></span>",
      "css": ".ds-chips{display:flex;gap:8px}.ds-chip{position:relative}.ds-chip input{position:absolute;opacity:0;width:1px;height:1px;margin:0}.ds-chip span{display:flex;align-items:center;min-height:46px;padding:0 16px;border:1.5px solid #8f846e;border-radius:10px;background:#fffdf8;font:600 16px var(--font);color:#1a2a3b;cursor:pointer;transition:border-color .15s,background-color .15s,box-shadow .15s}.ds-chip:hover span{border-color:#2f78d0}.ds-chip input:focus-visible+span{border-color:#2f78d0;box-shadow:0 0 0 3px rgba(47,120,208,.3)}.ds-chip input:checked+span{background:#11304f;border-color:#11304f;color:#fff}"
    },
    {
      "name": "Price Row",
      "kind": "custom",
      "refersTo": "price-row-arrow",
      "description": "Whole row links to the form; only the circled arrow reacts.",
      "html": "<a class=\"ds-row\" href=\"#\"><span class=\"ds-name\">2D Vastu Plan<span class=\"ds-note\">Ground floor up to 1000 sq ft</span></span><span class=\"ds-price\"><span class=\"ds-cur\">Rs</span>1000</span><span class=\"ds-arrow\"><svg viewBox=\"0 0 16 16\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 8h10M9 4l4 4-4 4\"/></svg></span></a>",
      "css": ".ds-row{display:grid;grid-template-columns:1fr auto 34px;align-items:center;gap:12px;padding:16px 0;min-height:64px;text-decoration:none;color:#1a2a3b;border-top:1.5px solid #d6ccb8;border-bottom:1.5px solid #d6ccb8;font-family:var(--font);background:#f6f1e6}.ds-row:focus-visible{outline:none}.ds-name{font-weight:750;font-size:18px;line-height:1.25}.ds-note{display:block;font-weight:400;font-size:15px;color:#4b5a6a;margin-top:2px}.ds-price{font-weight:850;font-size:22px;font-variant-numeric:tabular-nums;white-space:nowrap}.ds-cur{font-weight:600;font-size:.68em;margin-right:3px}.ds-arrow{width:34px;height:34px;border-radius:50%;border:1.5px solid #d6ccb8;display:grid;place-items:center;transition:background-color .2s,border-color .2s}.ds-row:hover .ds-arrow,.ds-row:focus-visible .ds-arrow{background:#f2a516;border-color:#f2a516}.ds-row:focus-visible .ds-arrow{outline:3px solid #2f78d0;outline-offset:3px}"
    },
    {
      "name": "Dimension-Line Divider",
      "kind": "custom",
      "refersTo": null,
      "description": "Section opener on paper: end ticks and a run that draws in on scroll.",
      "html": "<svg class=\"ds-dim\" viewBox=\"0 0 1000 22\" preserveAspectRatio=\"none\"><line class=\"ds-tick\" x1=\"1\" y1=\"2\" x2=\"1\" y2=\"20\"/><line class=\"ds-tick\" x1=\"999\" y1=\"2\" x2=\"999\" y2=\"20\"/><line class=\"ds-run\" pathLength=\"1\" x1=\"1\" y1=\"11\" x2=\"999\" y2=\"11\"/></svg>",
      "css": ".ds-dim{display:block;width:100%;height:22px;color:#d6ccb8}.ds-dim line{stroke:currentColor;stroke-width:1.5;fill:none}.ds-dim .ds-run{stroke-dasharray:1;stroke-dashoffset:1;animation:ds-draw 1.4s cubic-bezier(.16,1,.3,1) forwards}.ds-dim .ds-tick{opacity:0;animation:ds-tick .4s .9s forwards}@keyframes ds-draw{to{stroke-dashoffset:0}}@keyframes ds-tick{to{opacity:1}}@media (prefers-reduced-motion:reduce){.ds-dim .ds-run{animation:none;stroke-dashoffset:0}.ds-dim .ds-tick{animation:none;opacity:1}}"
    },
    {
      "name": "Plot Preview",
      "kind": "card",
      "refersTo": "plot-preview",
      "description": "Small blueprint panel drawing the visitor's plot to scale with the road side in marigold.",
      "html": "<svg class=\"ds-plot\" viewBox=\"0 0 360 240\"><rect x=\"90\" y=\"40\" width=\"180\" height=\"150\" fill=\"none\" stroke=\"#e4efff\" stroke-width=\"2.5\"/><rect x=\"90\" y=\"196\" width=\"180\" height=\"18\" rx=\"3\" fill=\"#f2a516\"/><text x=\"180\" y=\"209\" text-anchor=\"middle\" font-size=\"10\" class=\"ds-road\">ROAD</text><text x=\"180\" y=\"32\" text-anchor=\"middle\">30′</text><path d=\"M338 14 L344 32 L338 28 L332 32 Z\" fill=\"#f2a516\"/></svg>",
      "css": ".ds-plot{display:block;width:100%;max-width:360px;height:auto;border-radius:14px;background:#11304f}.ds-plot text{font:600 12px var(--font);fill:#cfe2f6}.ds-plot .ds-road{fill:#11304f;font-weight:800;letter-spacing:.12em}"
    },
    {
      "name": "Header",
      "kind": "nav",
      "refersTo": null,
      "description": "Blueprint bar: AVR mark and name left, tap-to-call number right.",
      "html": "<header class=\"ds-top\"><a class=\"ds-brand\" href=\"#\"><svg width=\"40\" height=\"40\" viewBox=\"0 0 40 40\"><rect x=\"1.5\" y=\"1.5\" width=\"37\" height=\"37\" rx=\"7\" fill=\"none\" stroke=\"#f2a516\" stroke-width=\"2.4\"/><text x=\"20\" y=\"25.5\" text-anchor=\"middle\" font-weight=\"900\" font-size=\"13.5\" fill=\"#fff\">AVR</text></svg><span><b>AVR Vasthu Home</b><small>2D Plan</small></span></a><a class=\"ds-tel\" href=\"#\">91500 09835</a></header>",
      "css": ".ds-top{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:64px;padding:0 20px;background:#11304f;color:#fff;font-family:var(--font)}.ds-brand{display:flex;align-items:center;gap:10px;color:inherit;text-decoration:none}.ds-brand b{display:block;font-weight:850;font-size:14px;letter-spacing:.03em;text-transform:uppercase;line-height:1.1}.ds-brand small{display:block;font-size:12px;color:#a9c6e4;letter-spacing:.04em}.ds-tel{font-weight:750;font-size:16px;color:inherit;text-decoration:none;font-variant-numeric:tabular-nums;min-height:44px;display:flex;align-items:center}.ds-tel:hover{text-decoration:underline}.ds-top :focus-visible{outline:3px solid #f2a516;outline-offset:3px;border-radius:6px}"
    }
  ],
  "narrative": {
    "northStar": "The Drafting Table",
    "overview": "A Vastu house plan drafted live on blueprint navy with a marigold pen; drafting-paper sections for reading prices, process and the form. Everything is drawn in line: walls, dimension lines, compass, scale preview. System type at heavy uppercase is the owner's house style.\n\nTouch takes the pen: walls snap to a 1-ft grid with live dimensions, and the compass needle swings toward the finger and springs back to north. Dimension-line dividers draw in on scroll; the form ends in a live scale drawing of the visitor's plot.",
    "keyCharacteristics": [
      "Blueprint navy grounds top and bottom, drafting paper between",
      "Marigold is the pen and the primary action",
      "Form Blue only for form interaction on paper",
      "System font stack, 850 uppercase display",
      "Line-drawn devices only: grid, walls, dimension lines, compass",
      "Flat sheet: no shadows except focus rings"
    ],
    "rules": [
      {
        "name": "The Drawn Not Decorated Rule",
        "body": "Every ornament is a drafting device the world owns.",
        "section": "overview"
      },
      {
        "name": "The North Returns Rule",
        "body": "Motion is physical and settles home; dividers draw once and stay.",
        "section": "overview"
      },
      {
        "name": "The One Pen Rule",
        "body": "Marigold always means the pen or the primary action, never decoration.",
        "section": "colors"
      },
      {
        "name": "The Blue Belongs To The Form Rule",
        "body": "Form Blue appears only on paper form states; on blueprint, focus is marigold.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "One system stack; hierarchy from weight and case.",
        "section": "typography"
      },
      {
        "name": "The Heavy Caps Rule",
        "body": "Display is always uppercase 850; body never in caps.",
        "section": "typography"
      },
      {
        "name": "The Flat Sheet Rule",
        "body": "No drop shadows; separation is a rule line or a change of ground.",
        "section": "elevation"
      },
      {
        "name": "The Line Weight Rule",
        "body": "Paper uses 1.5px lines; blueprint uses heavy walls and hairline annotations.",
        "section": "shapes"
      }
    ],
    "dos": [
      "Do draw with grid, walls, dimension lines, compass, door swings and scale drawings.",
      "Do keep marigold for the pen and primary action, Form Blue for form states on paper.",
      "Do keep prices verbatim with a small Rs and tabular figures.",
      "Do keep touch targets at 44px or more and drawings complete under reduced motion."
    ],
    "donts": [
      "Don't introduce a webfont or second typeface.",
      "Don't add shadows, gradient fills or glass panels.",
      "Don't add small uppercase labels above headings or decorative icons beside headings and list items.",
      "Don't use marigold as a large fill or put Form Blue on blueprint."
    ]
  }
}